# Required to enable the private /admin/ area. Use long, unique values in production.
ADMIN_PASSWORD=replace-with-a-strong-admin-password
SESSION_SECRET=replace-with-a-long-random-secret

# Server port and production mode
PORT=8787
NODE_ENV=production

# Optional order-notification email (Resend)
RESEND_API_KEY=
EMAIL_FROM=Career Minute <orders@your-domain.com>
